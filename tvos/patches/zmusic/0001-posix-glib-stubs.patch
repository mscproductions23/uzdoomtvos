diff --git a/thirdparty/fluidsynth/src/utils/posix_glibstubs.c b/thirdparty/fluidsynth/src/utils/posix_glibstubs.c
new file mode 100644
index 0000000..3aa8e60
--- /dev/null
+++ b/thirdparty/fluidsynth/src/utils/posix_glibstubs.c
@@ -0,0 +1,140 @@
+#ifndef WIN32
+
+#define _CRT_SECURE_NO_WARNINGS
+
+#include "fluidsynth_priv.h"
+#include "fluid_sys.h"
+#include "posix_glibstubs.h"
+
+#include <sys/stat.h>
+#include <unistd.h>
+#include <time.h>
+#include <stdlib.h>
+#include <string.h>
+
+int fluid_g_file_test(const char *path, int flags)
+{
+    struct stat st;
+    if (stat(path, &st) == -1)
+    {
+        return 0;
+    }
+    if (flags & G_FILE_TEST_EXISTS)
+    {
+        return 1;
+    }
+    if (flags & G_FILE_TEST_IS_REGULAR)
+    {
+        return S_ISREG(st.st_mode) ? 1 : 0;
+    }
+    return 0;
+}
+
+int fluid_g_stat(const char *path, void *statbuf)
+{
+    return stat(path, (struct stat *)statbuf);
+}
+
+double fluid_g_get_monotonic_time(void)
+{
+    struct timespec ts;
+    if (clock_gettime(CLOCK_MONOTONIC, &ts) != 0)
+    {
+        return 0.0;
+    }
+    return ts.tv_sec * 1000000.0 + ts.tv_nsec / 1000.0;
+}
+
+int fluid_g_shell_parse_argv(const char *command_line, int *argcp, char ***argvp, void *dummy)
+{
+    /* Simple stub: just return command_line as a single argument */
+    if (command_line == NULL)
+    {
+        return 0;
+    }
+
+    char **argv = (char **)malloc(3 * sizeof(char *));
+    if (argv == NULL)
+    {
+        return 0;
+    }
+
+    argv[0] = (char *)malloc(strlen(command_line) + 1);
+    if (argv[0] == NULL)
+    {
+        free(argv);
+        return 0;
+    }
+
+    strcpy(argv[0], command_line);
+    argv[1] = NULL;
+
+    if (argcp != NULL)
+    {
+        *argcp = 1;
+    }
+    if (argvp != NULL)
+    {
+        *argvp = argv;
+    }
+
+    return 1;
+}
+
+/* Thread support */
+static void *g_thread_wrapper(void *info_)
+{
+    GThread *info = (GThread *)info_;
+    info->func(info->data);
+    return NULL;
+}
+
+GThread *fluid_g_thread_create(GThreadFunc func, void *data, int joinable, GError **error)
+{
+    static GError error_container;
+
+    g_return_val_if_fail(func != NULL, NULL);
+
+    GThread *info = (GThread *)malloc(sizeof(GThread));
+    if (info == NULL)
+    {
+        return NULL;
+    }
+
+    info->func = func;
+    info->data = data;
+
+    int create_result = pthread_create(&info->thread, NULL, g_thread_wrapper, info);
+
+    if (error != NULL)
+    {
+        error_container.code = create_result;
+        error_container.message = create_result ? strerror(create_result) : NULL;
+        *error = &error_container;
+    }
+
+    if (create_result != 0)
+    {
+        free(info);
+        return NULL;
+    }
+
+    if (!joinable)
+    {
+        /* Release thread resources on exit, if caller doesn't want to join */
+        pthread_detach(info->thread);
+    }
+
+    return info;
+}
+
+void fluid_g_thread_join(GThread *thread)
+{
+    if (thread != NULL)
+    {
+        pthread_join(thread->thread, NULL);
+        free(thread);
+    }
+}
+
+#endif /* !WIN32 */
diff --git a/thirdparty/fluidsynth/src/utils/posix_glibstubs.h b/thirdparty/fluidsynth/src/utils/posix_glibstubs.h
new file mode 100644
index 0000000..efbdc69
--- /dev/null
+++ b/thirdparty/fluidsynth/src/utils/posix_glibstubs.h
@@ -0,0 +1,157 @@
+#ifndef _POSIX_GLIBSTUBS_H
+#define _POSIX_GLIBSTUBS_H
+
+#ifndef WIN32
+
+#include <assert.h>
+#include <stdint.h>
+#include <pthread.h>
+#include <alloca.h>
+
+typedef int gboolean;
+typedef int gint;
+typedef unsigned int guint;
+typedef int32_t gint32;
+typedef uint32_t guint32;
+typedef int64_t gint64;
+typedef uint64_t guint64;
+typedef unsigned char guchar;
+typedef char gchar;
+typedef unsigned short gushort;
+typedef void *gpointer;
+typedef const void *gconstpointer;
+
+#define TRUE 1
+#define FALSE 0
+
+#define GLIB_CHECK_VERSION(x, y, z) 0
+#define GLIB_MAJOR_VERSION 2
+#define GLIB_MINOR_VERSION 29
+
+typedef struct
+{
+    int code;
+    const char *message;
+} GError;
+
+#define g_new(s, c) FLUID_ARRAY(s, c)
+#define g_free(p) FLUID_FREE(p)
+#define g_strfreev FLUID_FREE
+#define g_newa(_type, _len) (_type *)alloca(sizeof(_type) * (_len))
+#define g_assert(a) assert(a)
+#define G_LIKELY(expr) (expr)
+#define G_UNLIKELY(expr) (expr)
+
+#define g_vsnprintf(b, c, f, a) vsnprintf(b, c, f, a)
+#define g_snprintf(b, c, f, ...) snprintf(b, c, f, __VA_ARGS__)
+
+#define g_return_val_if_fail(expr, val) if (expr) {} else { return val; }
+#define g_clear_error(err) do {} while (0)
+
+#define G_FILE_TEST_EXISTS 1
+#define G_FILE_TEST_IS_REGULAR 2
+
+#define g_file_test fluid_g_file_test
+#define g_shell_parse_argv fluid_g_shell_parse_argv
+#define g_stat fluid_g_stat
+int fluid_g_file_test(const char *path, int flags);
+int fluid_g_shell_parse_argv(const char *command_line, int *argcp, char ***argvp, void *dummy);
+int fluid_g_stat(const char *path, void *statbuf);
+
+#define g_get_monotonic_time fluid_g_get_monotonic_time
+double fluid_g_get_monotonic_time(void);
+
+#ifdef __BYTE_ORDER__
+#define G_BYTE_ORDER __BYTE_ORDER__
+#define G_BIG_ENDIAN __ORDER_BIG_ENDIAN__
+#else
+#define G_BYTE_ORDER 1234
+#define G_BIG_ENDIAN 4321
+#endif
+
+#if G_BYTE_ORDER == G_BIG_ENDIAN
+#define GINT16_FROM_LE(x) (int16_t)(((uint16_t)(x) >> 8) | ((uint16_t)(x) << 8))
+#define GINT32_FROM_LE(x) (int32_t)((FLUID_LE16TOH(x) << 16) | (FLUID16_LE16TOH(x >> 16)))
+#else
+#define GINT32_FROM_LE(x) (x)
+#define GINT16_FROM_LE(x) (x)
+#endif
+
+#define g_thread_supported() 1
+#define g_thread_init(_) do {} while (0)
+#define g_usleep(usecs) usleep(usecs)
+
+typedef gpointer (*GThreadFunc)(void *data);
+typedef struct
+{
+    GThreadFunc func;
+    void *data;
+    pthread_t thread;
+} GThread;
+
+#define g_thread_create fluid_g_thread_create
+#define g_thread_join fluid_g_thread_join
+GThread *fluid_g_thread_create(GThreadFunc func, void *data, int joinable, GError **error);
+void fluid_g_thread_join(GThread *thread);
+
+typedef pthread_mutex_t GStaticMutex;
+#define G_STATIC_MUTEX_INIT PTHREAD_MUTEX_INITIALIZER
+#define g_static_mutex_init(_m) do { pthread_mutex_init(_m, NULL); } while (0)
+#define g_static_mutex_free(_m) do { pthread_mutex_destroy(_m); } while (0)
+#define g_static_mutex_lock(_m) pthread_mutex_lock(_m)
+#define g_static_mutex_unlock(_m) pthread_mutex_unlock(_m)
+
+typedef pthread_mutex_t GStaticRecMutex;
+static inline void g_static_rec_mutex_init(GStaticRecMutex *m)
+{
+    pthread_mutexattr_t attr;
+    pthread_mutexattr_init(&attr);
+    pthread_mutexattr_settype(&attr, PTHREAD_MUTEX_RECURSIVE);
+    pthread_mutex_init(m, &attr);
+    pthread_mutexattr_destroy(&attr);
+}
+#define g_static_rec_mutex_free(_m) do { pthread_mutex_destroy(_m); } while (0)
+#define g_static_rec_mutex_lock(_m) pthread_mutex_lock(_m)
+#define g_static_rec_mutex_unlock(_m) pthread_mutex_unlock(_m)
+
+typedef pthread_mutex_t GMutex;
+#define g_mutex_free(m) do { if (m != NULL) { pthread_mutex_destroy(m); g_free(m); } } while(0)
+#define g_mutex_lock(m) pthread_mutex_lock(m)
+#define g_mutex_unlock(m) pthread_mutex_unlock(m)
+
+static inline GMutex *g_mutex_new(void)
+{
+    GMutex *mutex = g_new(GMutex, 1);
+    pthread_mutex_init(mutex, NULL);
+    return mutex;
+}
+
+typedef pthread_cond_t GCond;
+#define g_cond_free(cond) do { if (cond != NULL) { pthread_cond_destroy(cond); g_free(cond); } } while (0)
+#define g_cond_signal(cond) pthread_cond_signal(cond)
+#define g_cond_broadcast(cond) pthread_cond_broadcast(cond)
+#define g_cond_wait(cond, mutex) pthread_cond_wait(cond, mutex)
+
+static inline GCond *g_cond_new(void)
+{
+    GCond *cond = g_new(GCond, 1);
+    pthread_cond_init(cond, NULL);
+    return cond;
+}
+
+typedef pthread_key_t GStaticPrivate;
+#define g_static_private_init(_priv) do { pthread_key_create(_priv, NULL); } while (0)
+#define g_static_private_get(_priv) pthread_getspecific(*_priv)
+#define g_static_private_set(_priv, _data, _) pthread_setspecific(*_priv, _data)
+#define g_static_private_free(_priv) pthread_key_delete(*_priv)
+
+#define g_atomic_int_inc(_pi) __atomic_fetch_add(_pi, 1, __ATOMIC_SEQ_CST)
+#define g_atomic_int_get(_pi) __atomic_load_n(_pi, __ATOMIC_SEQ_CST)
+#define g_atomic_int_set(_pi, _val) __atomic_store_n(_pi, _val, __ATOMIC_SEQ_CST)
+#define g_atomic_int_dec_and_test(_pi) (__atomic_fetch_sub(_pi, 1, __ATOMIC_SEQ_CST) == 1)
+#define g_atomic_int_compare_and_exchange(_pi, _old, _new) __sync_bool_compare_and_swap(_pi, _old, _new)
+#define g_atomic_int_exchange_and_add(_pi, _add) __atomic_fetch_add(_pi, _add, __ATOMIC_SEQ_CST)
+
+#endif
+
+#endif
