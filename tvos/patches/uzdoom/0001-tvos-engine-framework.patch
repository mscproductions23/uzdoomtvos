diff --git a/src/common/platform/posix/sdl/uzdoom_entry.cpp b/src/common/platform/posix/sdl/uzdoom_entry.cpp
new file mode 100644
index 0000000..60e857d
--- /dev/null
+++ b/src/common/platform/posix/sdl/uzdoom_entry.cpp
@@ -0,0 +1,14 @@
+// uzdoom_entry.cpp: C entry point for the tvOS app (UZDoomEngine.framework).
+// Part of UZDoom; see LICENSE for terms.
+
+#include <SDL2/SDL.h>
+
+// SDL.h renames the engine's main() in i_main.cpp to SDL_main on tvOS.
+// The Swift app owns UIApplicationMain, so we mark SDL's main as ready
+// (same SDL copy: SDL2 is linked statically into this framework only)
+// and run the engine's main loop on the calling (main) thread.
+extern "C" __attribute__((visibility("default"))) int uzdoom_launch(int argc, char** argv)
+{
+	SDL_SetMainReady();
+	return SDL_main(argc, argv);
+}
