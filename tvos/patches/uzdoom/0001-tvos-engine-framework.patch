+
+protected:
+	struct AxisInfo
+	{
+		float Value;
+		float DeadZone;
+		float Multiplier;
+		EJoyAxis GameAxis;
+		uint8_t ButtonValue;
+	};
+	struct DefaultAxisConfig
+	{
+		float DeadZone;
+		EJoyAxis GameAxis;
+		float Multiplier;
+	};
+	enum
+	{
+		AXIS_ThumbLX,
+		AXIS_ThumbLY,
+		AXIS_ThumbRX,
+		AXIS_ThumbRY,
+		AXIS_LeftTrigger,
+		AXIS_RightTrigger,
+		NUM_AXES
+	};
+
+	float Multiplier;
+	AxisInfo Axes[NUM_AXES];
+	static DefaultAxisConfig DefaultAxes[NUM_AXES];
+	int LastButtons;
+	bool Connected;
+	bool Enabled;
+	double LastAimTime = 0;
+	bool TouchpadTouching = false;
+	float TouchpadX = 0, TouchpadY = 0;
+	bool TouchpadClick = false;
+
+	void Attached();
+	void Detached();
+	void ProcessAim(GCExtendedGamepad *pad);
+
+	static void ProcessThumbstick(float value1, AxisInfo *axis1, float value2, AxisInfo *axis2, int base);
+	static void ProcessTrigger(float value, AxisInfo *axis, int base);
+};
+
+// EXTERNAL FUNCTION PROTOTYPES --------------------------------------------
+
+// PUBLIC FUNCTION PROTOTYPES ----------------------------------------------
+
+// PRIVATE FUNCTION PROTOTYPES ---------------------------------------------
