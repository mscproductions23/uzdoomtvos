index 0000000..8cba827
--- /dev/null
+++ b/src/common/platform/posix/sdl/i_gcjoystick.mm
@@ -0,0 +1,864 @@
+// i_gcjoystick.mm: game controller input for tvOS via Apple's GameController framework. Part of UZDoom; see LICENSE for terms.
+
+#import <GameController/GameController.h>
+#import <Foundation/Foundation.h>
+#include "m_joy.h"
+#include "keydef.h"
+#include "basics.h"
+#include "cmdlib.h"
+#include "d_eventbase.h"
+#include "c_cvars.h"
+#include "menustate.h"
+#include <cmath>
+#include <mutex>
+
+// Touch pad from the iPhone Beam page (see BeamServer.swift). Written on the app's network
+// queue through uzdoom_set_touch_pad(), read on the main thread in ProcessInput().
+// axes: left X, left Y (+1 = up), right X, right Y (+1 = up), left trigger, right trigger (0..1).
+// buttons: same bit layout as FGCController::ProcessInput (bit N -> KEY_PAD_DPAD_UP + N).
+struct FTouchPadState
+{
+	float Axes[6];
+	uint32_t Buttons;
+	bool Connected;
+};
+static std::mutex TouchPadLock;
+static FTouchPadState TouchPad = {};
+
+extern "C" __attribute__((visibility("default"))) void uzdoom_set_touch_pad(const float *axes, unsigned int buttons, int connected)
+{
+	std::lock_guard<std::mutex> lock(TouchPadLock);
+	TouchPad.Connected = connected != 0;
+	for (int i = 0; i < 6; i++)
+		TouchPad.Axes[i] = (TouchPad.Connected && axes != nullptr) ? axes[i] : 0.f;
+	TouchPad.Buttons = TouchPad.Connected ? buttons : 0;
+}
+
+// Aim settings. The launcher's Controller Settings screen passes these on every start
+// (+joy_gyro 1 …), so they aren't saved in uzdoom.ini.
+CVAR(Bool, joy_gyro, false, 0)
+CVAR(Float, joy_gyro_sensitivity, 1.f, 0)
+CVAR(Bool, joy_gyro_invert_x, false, 0)
+CVAR(Bool, joy_gyro_invert_y, false, 0)
+CVAR(Bool, joy_touchpad_aim, false, 0)
+CVAR(Float, joy_touchpad_sensitivity, 1.f, 0)
+
+// Posts view rotation as EV_Mouse events. System_DispatchEvent turns ev.x into
+// G_AddViewAngle(int(ev.x * m_yaw * 16)) in 1/65536-turn units, so one unit of ev.x is
+// 16/65536 of a turn. Whole units are posted and the remainder carried over, so slow,
+// steady motion isn't lost to rounding. Positive yaw = turn right, positive pitch = look up.
+static void PostAimDegrees(double yawDeg, double pitchDeg)
+{
+	static double accYaw = 0, accPitch = 0;
+	if (menuactive != MENU_Off)
+	{
+		accYaw = accPitch = 0;
+		return;
+	}
+	accYaw += yawDeg * 65536.0 / 360.0;
+	accPitch += pitchDeg * 65536.0 / 360.0;
+	int yawUnits = int(accYaw);
+	int pitchUnits = int(accPitch);
+	accYaw -= yawUnits;
+	accPitch -= pitchUnits;
+	if (yawUnits == 0 && pitchUnits == 0)
+		return;
+
+	event_t ev = {};
+	ev.type = EV_Mouse;
+	ev.x = yawUnits / 16.f;
+	ev.y = pitchUnits / 16.f;
+	D_PostEvent(&ev);
+}
+
+// MACROS ------------------------------------------------------------------
+
+// TYPES -------------------------------------------------------------------
+
