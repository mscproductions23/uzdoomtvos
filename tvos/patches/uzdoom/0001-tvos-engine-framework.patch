+//==========================================================================
+
+void FGCController::SetAxisDeadZone(int axis, float deadzone)
+{
+	if (unsigned(axis) < NUM_AXES)
+	{
+		Axes[axis].DeadZone = clamp(deadzone, 0.f, 1.f);
+	}
+}
