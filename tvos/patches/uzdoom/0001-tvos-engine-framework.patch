+#ifdef UZ_TVOS
+// tvOS kills an app that submits GPU work while in the background, so when
+// the app is about to leave the foreground, finish pending GPU work and block
+// here (still pumping UIKit through SDL_WaitEvent) until it is back.
+static void I_TvosSuspend()
+{
+	S_SetSoundPaused(0);
+	if (screen != nullptr)
+		screen->WaitForCommands(false);
+
+	SDL_Event ev;
+	while (SDL_WaitEvent(&ev))
+	{
+		if (ev.type == SDL_QUIT || ev.type == SDL_APP_TERMINATING)
+			throw CExitEvent(0);
+		if (ev.type == SDL_APP_DIDENTERFOREGROUND)
+			break;
+	}
+	S_SetSoundPaused(1);
+}
+
+// The Siri Remote shows up as an SDL joystick with 2 axes (touch surface),
+// no hats and 3 buttons: 0 = click, 1 = play/pause, 2 = menu/back.
+static bool I_IsSiriRemote(SDL_JoystickID which)
+{
+	SDL_Joystick *joy = SDL_JoystickFromInstanceID(which);
+	return joy != nullptr && SDL_JoystickNumAxes(joy) == 2 &&
+		SDL_JoystickNumHats(joy) == 0 && SDL_JoystickNumButtons(joy) == 3;
+}
+
+// The remote has too few buttons for the generic joystick bindings, so its
+// buttons are sent as the keys that the default bindings already use.
+// The key chosen on press is remembered so the release matches it.
+static void I_PostSiriRemoteButton(const SDL_JoyButtonEvent &jb)
+{
+	static const int menuKeys[3] = { KEY_ENTER, KEY_BACKSPACE, KEY_ESCAPE };
+	static const int gameKeys[3] = { KEY_MOUSE1, KEY_SPACE, KEY_ESCAPE };
+	static int downKey[3] = { 0, 0, 0 };
+
+	if (jb.button >= 3)
+		return;
+
+	event_t event = { 0,0,0,0,0,0,0 };
+	if (jb.state == SDL_PRESSED)
+	{
+		downKey[jb.button] = menuactive != MENU_Off ? menuKeys[jb.button] : gameKeys[jb.button];
+		event.type = EV_KeyDown;
+		event.data1 = downKey[jb.button];
+	}
+	else
+	{
+		if (downKey[jb.button] == 0)
+			return;
+		event.type = EV_KeyUp;
+		event.data1 = downKey[jb.button];
+		downKey[jb.button] = 0;
+	}
+	D_PostEvent(&event);
+}
+#endif
