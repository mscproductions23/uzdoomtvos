index 0000000..302aa11
--- /dev/null
+++ b/src/common/platform/posix/sdl/i_gcjoystick.mm
@@ -0,0 +1,689 @@
+// i_gcjoystick.mm: game controller input for tvOS via Apple's GameController framework. Part of UZDoom; see LICENSE for terms.
+
+#import <GameController/GameController.h>
+#include "m_joy.h"
+#include "keydef.h"
+#include "basics.h"
+#include "cmdlib.h"
+#include "d_eventbase.h"
+#include <cmath>
+
+// MACROS ------------------------------------------------------------------
+
+// TYPES -------------------------------------------------------------------
+
+class FGCController : public IJoystickConfig
+{
+public:
+	FGCController();
+	~FGCController();
+
+	void ProcessInput();
+	void AddAxes(float axes[NUM_JOYAXIS]);
+	bool IsConnected() { return Connected; }
+
+	// IJoystickConfig interface
+	FString GetName();
+	float GetSensitivity();
+	virtual void SetSensitivity(float scale);
+
+	int GetNumAxes();
+	float GetAxisDeadZone(int axis);
+	EJoyAxis GetAxisMap(int axis);
+	const char *GetAxisName(int axis);
+	float GetAxisScale(int axis);
+
+	void SetAxisDeadZone(int axis, float deadzone);
+	void SetAxisMap(int axis, EJoyAxis gameaxis);
+	void SetAxisScale(int axis, float scale);
+
+	bool IsSensitivityDefault();
+	bool IsAxisDeadZoneDefault(int axis);
+	bool IsAxisMapDefault(int axis);
+	bool IsAxisScaleDefault(int axis);
+
+	bool GetEnabled();
+	void SetEnabled(bool enabled);
+
+	bool AllowsEnabledInBackground() { return false; }
+	bool GetEnabledInBackground() { return false; }
+	void SetEnabledInBackground(bool enabled) {}
+
+	void SetDefaultConfig();
+	FString GetIdentifier();
+
+protected:
+	struct AxisInfo
+	{
+		float Value;
+		float DeadZone;
+		float Multiplier;
+		EJoyAxis GameAxis;
+		uint8_t ButtonValue;
+	};
+	struct DefaultAxisConfig
+	{
+		float DeadZone;
+		EJoyAxis GameAxis;
+		float Multiplier;
+	};
+	enum
+	{
+		AXIS_ThumbLX,
+		AXIS_ThumbLY,
+		AXIS_ThumbRX,
+		AXIS_ThumbRY,
+		AXIS_LeftTrigger,
+		AXIS_RightTrigger,
+		NUM_AXES
+	};
+
+	float Multiplier;
+	AxisInfo Axes[NUM_AXES];
+	static DefaultAxisConfig DefaultAxes[NUM_AXES];
+	int LastButtons;
+	bool Connected;
+	bool Enabled;
+
+	void Attached();
+	void Detached();
+
+	static void ProcessThumbstick(float value1, AxisInfo *axis1, float value2, AxisInfo *axis2, int base);
+	static void ProcessTrigger(float value, AxisInfo *axis, int base);
+};
+
+// EXTERNAL FUNCTION PROTOTYPES --------------------------------------------
+
+// PUBLIC FUNCTION PROTOTYPES ----------------------------------------------
+
+// PRIVATE FUNCTION PROTOTYPES ---------------------------------------------
+
+// EXTERNAL DATA DECLARATIONS ----------------------------------------------
+
+// PUBLIC DATA DEFINITIONS -------------------------------------------------
+
+// PRIVATE DATA DEFINITIONS ------------------------------------------------
+
+static const char *AxisNames[] =
+{
+	"Left Thumb X Axis",
+	"Left Thumb Y Axis",
+	"Right Thumb X Axis",
+	"Right Thumb Y Axis",
+	"Left Trigger",
+	"Right Trigger"
+};
+
+FGCController::DefaultAxisConfig FGCController::DefaultAxes[NUM_AXES] =
+{
+	// Dead zone, game axis, multiplier
+	{ 0.24f, JOYAXIS_Side, 1 },			// ThumbLX
+	{ 0.24f, JOYAXIS_Forward, 1 },		// ThumbLY
+	{ 0.265f, JOYAXIS_Yaw, 1 },			// ThumbRX
+	{ 0.265f, JOYAXIS_Pitch, 0.75f },	// ThumbRY
+	{ 0.117f, JOYAXIS_None, 0 },		// LeftTrigger
+	{ 0.117f, JOYAXIS_None, 0 }			// RightTrigger
+};
+
+// CODE --------------------------------------------------------------------
+
+//==========================================================================
+//
+// FGCController - Constructor
+//
+//==========================================================================
+
+FGCController::FGCController()
+{
+	Connected = false;
+	Enabled = true;
+	LastButtons = 0;
+	SetDefaultConfig();
+	M_LoadJoystickConfig(this);
+}
+
+//==========================================================================
+//
+// FGCController - Destructor
+//
+//==========================================================================
+
+FGCController::~FGCController()
+{
+	// Send button up events before destroying this.
+	ProcessThumbstick(0, &Axes[AXIS_ThumbLX], 0, &Axes[AXIS_ThumbLY], KEY_PAD_LTHUMB_RIGHT);
+	ProcessThumbstick(0, &Axes[AXIS_ThumbRX], 0, &Axes[AXIS_ThumbRY], KEY_PAD_RTHUMB_RIGHT);
+	ProcessTrigger(0, &Axes[AXIS_LeftTrigger], KEY_PAD_LTRIGGER);
+	ProcessTrigger(0, &Axes[AXIS_RightTrigger], KEY_PAD_RTRIGGER);
+	Joy_GenerateButtonEvents(LastButtons, 0, 16, KEY_PAD_DPAD_UP);
+	M_SaveJoystickConfig(this);
+}
+
+//==========================================================================
+//
+// FGCController :: ProcessInput
+//
+//==========================================================================
+
+void FGCController::ProcessInput()
+{
+	@autoreleasepool
+	{
+		GCExtendedGamepad *pad = nil;
+		for (GCController *c in [GCController controllers])
+		{
+			if (c.extendedGamepad != nil)
+			{
+				pad = c.extendedGamepad;
+				break;
+			}
+		}
+
+		if (pad == nil)
+		{
+			if (Connected)
+			{
+				Detached();
+			}
+			return;
+		}
+
+		if (!Connected)
+		{
+			Attached();
+		}
+
+		if (!Enabled)
+		{
+			return;
+		}
+
+		// GameController gives -1..1 with +Y = up; negate Y for engine's +Y = down convention
+		ProcessThumbstick(pad.leftThumbstick.xAxis.value, &Axes[AXIS_ThumbLX],
+						 -pad.leftThumbstick.yAxis.value, &Axes[AXIS_ThumbLY], KEY_PAD_LTHUMB_RIGHT);
+		ProcessThumbstick(pad.rightThumbstick.xAxis.value, &Axes[AXIS_ThumbRX],
+						 -pad.rightThumbstick.yAxis.value, &Axes[AXIS_ThumbRY], KEY_PAD_RTHUMB_RIGHT);
+		ProcessTrigger(pad.leftTrigger.value, &Axes[AXIS_LeftTrigger], KEY_PAD_LTRIGGER);
+		ProcessTrigger(pad.rightTrigger.value, &Axes[AXIS_RightTrigger], KEY_PAD_RTRIGGER);
+
+		// Build button state using XInput bit layout
+		int buttons = 0;
+		if (pad.dpad.up.pressed)    buttons |= 1 << 0;
+		if (pad.dpad.down.pressed)  buttons |= 1 << 1;
+		if (pad.dpad.left.pressed)  buttons |= 1 << 2;
+		if (pad.dpad.right.pressed) buttons |= 1 << 3;
+		if (pad.buttonMenu.pressed) buttons |= 1 << 4;  // KEY_PAD_START
+		if (pad.buttonOptions != nil && pad.buttonOptions.pressed) buttons |= 1 << 5;  // KEY_PAD_BACK
+		if (pad.leftThumbstickButton != nil && pad.leftThumbstickButton.pressed) buttons |= 1 << 6;
+		if (pad.rightThumbstickButton != nil && pad.rightThumbstickButton.pressed) buttons |= 1 << 7;
+		if (pad.leftShoulder.pressed)  buttons |= 1 << 8;
+		if (pad.rightShoulder.pressed) buttons |= 1 << 9;
+		// bits 10 and 11 are the triggers (handled above via ProcessTrigger)
+		if (pad.buttonA.pressed) buttons |= 1 << 12;
+		if (pad.buttonB.pressed) buttons |= 1 << 13;
+		if (pad.buttonX.pressed) buttons |= 1 << 14;
+		if (pad.buttonY.pressed) buttons |= 1 << 15;
+
+		Joy_GenerateButtonEvents(LastButtons, buttons, 16, KEY_PAD_DPAD_UP);
+		LastButtons = buttons;
+	}
+}
+
+//==========================================================================
+//
+// FGCController :: ProcessThumbstick						STATIC
+//
+// Converts both axes of a thumb stick to floating point, cancels out the
+// deadzone, and generates button up/down events for them.
+//
+//==========================================================================
+
+void FGCController::ProcessThumbstick(float value1, AxisInfo *axis1,
+	float value2, AxisInfo *axis2, int base)
+{
+	uint8_t buttonstate;
+	double axisval1, axisval2;
+
+	// Input values are already -1..1 from GameController
+	axisval1 = Joy_RemoveDeadZone(value1, axis1->DeadZone, NULL);
+	axisval2 = Joy_RemoveDeadZone(value2, axis2->DeadZone, NULL);
+	axis1->Value = float(axisval1);
+	axis2->Value = float(axisval2);
+
+	// We store all four buttons in the first axis and ignore the second.
+	buttonstate = Joy_XYAxesToButtons(axisval1, axisval2);
+	Joy_GenerateButtonEvents(axis1->ButtonValue, buttonstate, 4, base);
+	axis1->ButtonValue = buttonstate;
+}
+
+//==========================================================================
+//
+// FGCController :: ProcessTrigger							STATIC
+//
+// Much like ProcessThumbstick, except triggers only go in the positive
+// direction and have less precision.
+//
+//==========================================================================
+
+void FGCController::ProcessTrigger(float value, AxisInfo *axis, int base)
+{
+	uint8_t buttonstate;
+	double axisval;
+
+	// Input value is 0..1 from GameController
+	axisval = Joy_RemoveDeadZone(value, axis->DeadZone, &buttonstate);
+	Joy_GenerateButtonEvents(axis->ButtonValue, buttonstate, 1, base);
+	axis->ButtonValue = buttonstate;
+	axis->Value = float(axisval);
+}
+
+//==========================================================================
+//
+// FGCController :: Attached
+//
+// This controller was just attached. Set all buttons and axes to 0.
+//
+//==========================================================================
+
+void FGCController::Attached()
+{
+	int i;
+
+	Connected = true;
+	LastButtons = 0;
+	for (i = 0; i < NUM_AXES; ++i)
+	{
+		Axes[i].Value = 0;
+		Axes[i].ButtonValue = 0;
+	}
+	UpdateJoystickMenu(this);
+}
+
+//==========================================================================
+//
+// FGCController :: Detached
+//
+// This controller was just detached. Send button ups for buttons that
+// were pressed the last time we got input from it.
+//
+//==========================================================================
+
+void FGCController::Detached()
+{
+	int i;
+
+	Connected = false;
+	for (i = 0; i < 4; i += 2)
+	{
+		ProcessThumbstick(0, &Axes[i], 0, &Axes[i+1], KEY_PAD_LTHUMB_RIGHT + i*2);
+	}
+	for (i = 0; i < 2; ++i)
+	{
+		ProcessTrigger(0, &Axes[4+i], KEY_PAD_LTRIGGER + i);
+	}
+	Joy_GenerateButtonEvents(LastButtons, 0, 16, KEY_PAD_DPAD_UP);
+	LastButtons = 0;
+	UpdateJoystickMenu(NULL);
+}
+
+//==========================================================================
+//
+// FGCController :: AddAxes
+//
+// Add the values of each axis to the game axes.
+//
+//==========================================================================
+
+void FGCController::AddAxes(float axes[NUM_JOYAXIS])
+{
+	// Add to game axes.
+	if (Connected)
+	{
+		for (int i = 0; i < NUM_AXES; ++i)
+		{
+			if (Axes[i].GameAxis != JOYAXIS_None)
+				axes[Axes[i].GameAxis] -= float(Axes[i].Value * Multiplier * Axes[i].Multiplier);
+		}
+	}
+}
+
+//==========================================================================
+//
+// FGCController :: SetDefaultConfig
+//
+//==========================================================================
+
+void FGCController::SetDefaultConfig()
+{
+	Multiplier = 1;
+	for (int i = 0; i < NUM_AXES; ++i)
+	{
+		Axes[i].DeadZone = DefaultAxes[i].DeadZone;
+		Axes[i].GameAxis = DefaultAxes[i].GameAxis;
+		Axes[i].Multiplier = DefaultAxes[i].Multiplier;
+	}
+}
