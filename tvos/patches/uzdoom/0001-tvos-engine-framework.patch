@@ -449,12 +449,36 @@ bool ImageBuilder::IsFormatSupported(VulkanDevice* device, VkFormatFeatureFlags
 	return true;
 }
 
+#ifdef UZ_TVOS
+// MoltenVK 1.2.7+ only gives a Metal texture MTLTextureUsagePixelFormatView when the
+// image is created with MUTABLE_FORMAT (and is sampled/rendered). Without it, the
+// title screen and menus come out with scrambled colour channels on Apple GPUs
+// (pink or green; UZDoom issue #1116, MoltenVK issue #2220). Restore the old
+// behaviour for every colour image.
+static VkImageCreateInfo ApplePixelFormatViewWorkaround(VkImageCreateInfo info)
+{
+	bool isDepthStencil = info.format >= VK_FORMAT_D16_UNORM && info.format <= VK_FORMAT_D32_SFLOAT_S8_UINT;
+	if (!isDepthStencil)
+	{
+		info.flags |= VK_IMAGE_CREATE_MUTABLE_FORMAT_BIT;
+		if (info.usage & VK_IMAGE_USAGE_TRANSFER_SRC_BIT)
+			info.usage |= VK_IMAGE_USAGE_SAMPLED_BIT;
+	}
+	return info;
+}
+#endif
